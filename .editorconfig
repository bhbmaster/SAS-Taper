root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{html,js,json,yml,yaml,xml}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[LICENSE]
trim_trailing_whitespace = false
